# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_ — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Daily.co (dashboard.daily.co -> Developers)
DAILY_API_KEY=
# Your Daily subdomain, e.g. "afrima.daily.co" (no https://) — used to build
# the room join URL returned by /api/daily/token.
DAILY_DOMAIN=
